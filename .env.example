# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Find these in the Supabase dashboard: Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. Not needed yet; used later for account deletion and the data import.
# Never add NEXT_PUBLIC_ in front of this name.
SUPABASE_SECRET_KEY=
